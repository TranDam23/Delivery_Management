# Copy this file to .env in the relevant app/package and fill in values.
# This root file just documents every variable used across the monorepo.

# ===== Supabase (apps/web, packages/database) =====
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_DB_PASSWORD=your-db-password
SUPABASE_PROJECT_REF=your-project-ref

# ===== Blockchain (apps/web, packages/contracts) =====
# Polygon Amoy testnet RPC (get a free key at alchemy.com / infura.io)
POLYGON_AMOY_RPC_URL=https://polygon-amoy.g.alchemy.com/v2/your-api-key
# Private key of the deployer/operator wallet (NEVER commit a real key)
BLOCKCHAIN_PRIVATE_KEY=0xyourprivatekey
# Deployed DeliveryTracking contract address (filled after `pnpm contracts:deploy:testnet`)
NEXT_PUBLIC_DELIVERY_CONTRACT_ADDRESS=0xdeployedcontractaddress
POLYGONSCAN_API_KEY=your-polygonscan-api-key

# ===== Auth =====
JWT_SECRET=change-me-in-production

# ===== Mobile (apps/mobile) =====
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000/api
EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

POLYGON_AMOY_RPC_URL=https://polygon-amoy-bor-rpc.publicnode.com
BLOCKCHAIN_PRIVATE_KEY=0xyourprivatekey
NEXT_PUBLIC_DELIVERY_CONTRACT_ADDRESS=0xdeployedcontractaddress
# Dat "true" de ghi cac moc giao nhan len chain (mac dinh tat cho toi GD5 Blockchain)
BLOCKCHAIN_WRITE_ENABLED=false

JWT_SECRET=change-me-in-production

# Google Maps (chua dung): key trinh duyet cho Maps JavaScript/Places, gioi han theo domain
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Key server cho Geocoding API (bo sung toa do kho/dia chi cu), khong dua ra client
GOOGLE_MAPS_SERVER_KEY=

# Cloudinary: luu anh minh chung giao hang (Settings > API Keys tren console.cloudinary.com)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Thu muc goc tren Cloudinary, mac dinh delivertrust
CLOUDINARY_UPLOAD_FOLDER=delivertrust

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
NEXT_PUBLIC_APP_URL=http://localhost:3000

POLYGON_AMOY_RPC_URL=https://polygon-amoy-bor-rpc.publicnode.com
BLOCKCHAIN_PRIVATE_KEY=0xyourprivatekey
NEXT_PUBLIC_DELIVERY_CONTRACT_ADDRESS=0xdeployedcontractaddress
# Dat "true" de ghi cac moc giao nhan len chain (mac dinh tat cho toi GD5 Blockchain)
BLOCKCHAIN_WRITE_ENABLED=false

JWT_SECRET=change-me-in-production

# Ban do chon dia chi: de TRONG thi dung OpenStreetMap + Leaflet + Nominatim (mien phi, khong can khoa).
# Dien khoa Google de chuyen sang Google Maps: bat Maps JavaScript + Geocoding API; gioi han browser key theo domain va API
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Key server cho Geocoding API (bo sung toa do kho/dia chi cu), khong dua ra client
GOOGLE_MAPS_SERVER_KEY=

# Cloudinary: luu anh minh chung giao hang (Settings > API Keys tren console.cloudinary.com)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Thu muc goc tren Cloudinary, mac dinh delivertrust
CLOUDINARY_UPLOAD_FOLDER=delivertrust

# Bi mat cho cron goi POST/GET /api/alerts/scan (workflow .github/workflows/alert-scan.yml)
CRON_SECRET=

# Dich vu tim dia chi tren ban do (Nominatim, OpenStreetMap): may chu goi thay trinh duyet. Tuy chon.
# NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
# NOMINATIM_USER_AGENT=TenUngDung/1.0 (email-lien-he)
# Thu tu dich vu tim dia chi (mac dinh photon truoc, nominatim du phong). Photon/Nominatim deu mien phi, khong can khoa.
# GEOCODER_PROVIDERS=photon,nominatim
# PHOTON_BASE_URL=https://photon.komoot.io

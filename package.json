{
  "name": "delivery-management",
  "private": true,
  "version": "0.1.0",
  "description": "He thong quan ly va xac thuc quy trinh giao nhan hang hoa ung dung Blockchain",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@delivery/web",
    "dev:mobile": "turbo run dev --filter=@delivery/mobile",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "test": "turbo run test",
    "db:migrate": "pnpm --filter @delivery/database supabase:push",
    "db:gen-types": "pnpm --filter @delivery/database supabase:gen-types",
    "contracts:compile": "pnpm --filter @delivery/contracts compile",
    "contracts:deploy:testnet": "pnpm --filter @delivery/contracts deploy:amoy",
    "clean": "turbo run clean && rimraf node_modules"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.7.3",
    "rimraf": "^6.0.1",
    "prettier": "^3.4.2"
  }
}
